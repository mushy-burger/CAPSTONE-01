# MotoTrack production configuration. Replace every placeholder on Hostinger.
# Never commit or upload the completed .env file.

APP_URL=https://your-domain.example

DB_HOST=your-hostinger-db-host
DB_PORT=3306
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_database_user
DB_PASS=replace-with-database-password
DB_CHARSET=utf8mb4

PAYMONGO_SECRET_KEY=replace-with-paymongo-secret-key
PAYMONGO_PUBLIC_KEY=replace-with-paymongo-public-key
PAYMONGO_WEBHOOK_SECRET=replace-with-paymongo-webhook-secret
PAYMONGO_WEBHOOK_URL=https://your-domain.example/paymongo-webhook.php

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.example/google-callback.php

GMAIL_OAUTH_CLIENT_SECRET_PATH=/home/your-account/private/mototrack-gmail-client.json
GMAIL_OAUTH_TOKEN_PATH=/home/your-account/private/mototrack-gmail-token.json
GMAIL_OAUTH_REDIRECT_URI=https://your-domain.example/admin/gmail-callback.php
GMAIL_SENDER_EMAIL=you@example.com
GMAIL_SENDER_NAME=MotoTrack
GMAIL_MESSAGE_ID_DOMAIN=your-domain.example

MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME=MotoTrack

SMS_PROVIDER=semaphore
SMS_SENDER_NAME=MotoTrack
SMS_DRY_RUN=0
SEMAPHORE_API_KEY=replace-with-semaphore-api-key
SEMAPHORE_SENDER_NAME=MotoTrack
SEMAPHORE_DRY_RUN=0
MOCEAN_API_TOKEN=replace-with-moceansms-api-token
MOCEAN_SENDER_NAME=MotoTrack

MOTORCYCLE_API_ENDPOINT=https://api.example.com
MOTORCYCLE_API_KEY=replace-with-motorcycle-api-key

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
