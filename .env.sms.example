# ---------------------------------------------------------------------------
# SMS notifications — copy these keys into your real .env file.
#
# .env is gitignored and must NEVER be committed. This example file carries
# placeholder values only.
# ---------------------------------------------------------------------------

# Which provider to use: mocean (default) or semaphore.
SMS_PROVIDER=mocean

# Sender ID shown to the recipient. Some networks/providers require this to be
# registered first; unregistered IDs may be replaced by the provider's default.
SMS_SENDER_NAME=MotoTrack

# true  = messages are logged to storage/logs/sms.log and NOT sent (no credits used)
# false = messages are really sent
SMS_DRY_RUN=true

# --- MoceanAPI (https://moceanapi.com) -------------------------------------
# Dashboard -> API Account -> API Token
# NOTE: before your first payment, Mocean only delivers to numbers listed under
#       Dashboard -> Test Numbers.
MOCEAN_API_TOKEN=your_mocean_api_token_here

# --- Semaphore (https://semaphore.co) — alternative provider ----------------
# Dashboard -> API Key. Only used when SMS_PROVIDER=semaphore.
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=MotoTrack

# Used in notification emails
MAIL_FROM_ADDRESS=no-reply@renz88.app
MAIL_FROM_NAME=MotoTrack

# ---------------------------------------------------------------------------
# EMAIL DELIVERY
#
# MotoTrack sends mail with PHP's mail() (includes/mail.php), which needs a
# mail transport. XAMPP does not ship one, so on this machine mail() returns
# false and notifications are logged as 'failed' — that is expected locally and
# is not a code fault. OTP and order emails have the same limitation.
#
# To make email actually deliver, ONE of:
#
#   1. Live server with sendmail/postfix — usually works with no code change.
#
#   2. XAMPP + an SMTP relay, by editing C:\xampp\php\php.ini:
#          SMTP = smtp.yourprovider.com
#          smtp_port = 587
#          sendmail_from = no-reply@yourdomain.com
#      then restart Apache. Note php.ini's mail() has no SMTP authentication,
#      so this only works with a relay that does not require a login.
#
#   3. An authenticated provider (Gmail, SendGrid, Mailgun): that needs an SMTP
#      library such as PHPMailer, since mail() cannot authenticate. This would
#      be a change inside includes/mail.php only — every caller already goes
#      through sendNotificationEmail() / sendOtpEmail() / sendOrderEmail().
# ---------------------------------------------------------------------------
